{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayani.local/spec/worktree/progress_status.schema.json",
  "title": "Nabhani Mind Worktree Progress Schema",
  "type": "object",
  "required": [
    "root_node",
    "branches",
    "nodes",
    "dependencies",
    "statuses",
    "residuals",
    "next_prs"
  ],
  "properties": {
    "root_node": {"type": "string"},
    "branches": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "name",
          "type",
          "parent",
          "dependencies",
          "progress_status",
          "evidence_paths",
          "residuals",
          "next_actions"
        ],
        "properties": {
          "node_id": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "parent": {
            "anyOf": [
              {"type": "string"},
              {"type": "null"}
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "progress_status": {
            "type": "string",
            "enum": [
              "CERTIFICATE",
              "HYPOTHESIS",
              "ZERO",
              "SPEC_ONLY",
              "PARTIAL_RUNTIME",
              "RUNTIME_TESTED",
              "GOVERNANCE_ENFORCED"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "residuals": {
            "type": "array",
            "items": {"type": "string"}
          },
          "next_actions": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "statuses": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "why_it_matters", "what_fixes_it", "proposed_next_pr"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "what_fixes_it": {"type": "string"},
          "proposed_next_pr": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_prs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "scope"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "scope": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
