{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/spec/worktree/operational_epistemic_vocabulary.schema.json",
  "title": "Operational Epistemic Vocabulary Worktree Schema",
  "type": "object",
  "required": [
    "worktree",
    "version",
    "chain",
    "final_epistemic_judgments",
    "nodes"
  ],
  "properties": {
    "worktree": {"const": "operational_epistemic_vocabulary"},
    "version": {"type": "string", "minLength": 1},
    "chain": {
      "type": "array",
      "description": "Phase 2.1A canonical chain length fixed to 16 nodes and must stay aligned with the node_id enum.",
      "minItems": 16,
      "items": {"type": "string", "minLength": 1}
    },
    "final_epistemic_judgments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "enum": ["ZERO", "HYPOTHESIS", "CERTIFICATE"]}
    },
    "nodes": {
      "type": "array",
      "description": "Must include all 16 canonical operational epistemic vocabulary objects.",
      "minItems": 16,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "rank",
        "definition",
        "mathematical_form",
        "programming_contract",
        "linguistic_function",
        "required_inputs",
        "outputs",
        "forbidden_transitions",
        "residuals",
        "next_nodes"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "enum": [
            "epistemic_zero",
            "attention",
            "distinction",
            "designation",
            "identity",
            "universal",
            "particular",
            "domain",
            "aspect",
            "temporal_scope",
            "judgment_rank",
            "contradiction_check",
            "linking",
            "interpretation",
            "conception",
            "judgment"
          ]
        },
        "rank": {"type": "integer", "minimum": 1},
        "definition": {"type": "string", "minLength": 1},
        "mathematical_form": {"type": "string", "minLength": 1},
        "programming_contract": {"type": "string", "minLength": 1},
        "linguistic_function": {"type": "string", "minLength": 1},
        "required_inputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_transitions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "residuals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "next_nodes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_final_judgments": {
          "type": "array",
          "items": {"type": "string", "enum": ["ZERO", "HYPOTHESIS", "CERTIFICATE"]}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
