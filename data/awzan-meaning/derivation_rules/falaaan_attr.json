{
  "rule_id": "falaaan_attr_derivation",
  "rule_name_ar": "قاعدة اشتقاق الصفة المشبّهة على وزن فَعْلَان",
  "target_pattern": "فَعْلَان",
  "target_pattern_id": "falaaan_attr",
  "summary_ar": "فاء مفتوحة + عين ساكنة + لام مفتوحة + ألف + نون، صفة مشبّهة تدلّ على معنى عارض أو حالة مؤقتة، وكثيراً ما تدلّ على الامتلاء أو الانفعال.",

  "base_rule": {
    "description_ar": "الصفة المشبّهة على وزن فَعْلَان تُصاغ من الفعل الثلاثي اللازم على باب فَعِل (بكسر العين في الماضي)، بفتح الفاء، وإسكان العين، وفتح اللام، وزيادة ألف ونون. تدلّ غالباً على الامتلاء بشيء أو الاتصاف بحالة عارضة.",
    "operations": [
      {
        "step": 1,
        "operation_id": "fath_fa",
        "description_ar": "فتح فاء الكلمة",
        "target_position": "root[0]",
        "harakah": "fatha",
        "harakah_code": "\u064E"
      },
      {
        "step": 2,
        "operation_id": "silent_ain",
        "description_ar": "إسكان عين الكلمة",
        "target_position": "root[1]",
        "harakah": "sukun",
        "harakah_code": "\u0652"
      },
      {
        "step": 3,
        "operation_id": "fath_lam",
        "description_ar": "فتح لام الكلمة",
        "target_position": "root[2]",
        "harakah": "fatha",
        "harakah_code": "\u064E"
      },
      {
        "step": 4,
        "operation_id": "append_alif_noon",
        "description_ar": "زيادة ألف ونون بعد اللام",
        "insert_at": "end",
        "insert_letter": "ان"
      }
    ],
    "example_walkthrough": {
      "root": ["ع", "ط", "ش"],
      "verb": "عَطِشَ",
      "wazn_template": "فَ + عْـ + لَـ + ان",
      "derivation": "عَ + طْـ + شَـ + ان",
      "result": "عَطْشَان"
    }
  },

  "application_conditions": {
    "description_ar": "تنطبق صيغة 'فَعْلَان' بالشروط التالية",
    "conditions": [
      {
        "condition_id": "from_fail_lazim",
