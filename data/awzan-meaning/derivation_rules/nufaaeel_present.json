        "description_ar": "إسكان الفاء (الحرف الأول من الجذر)",
        "target_position": "root[0]",
        "harakah": "sukun"
      },
      {
        "step": 3,
        "description_ar": "حركة العين kasra",
        "target_position": "root[1]",
        "harakah": "kasra"
      }
    ]
  },
  "mudaariah_letters": {
    "description_ar": "حروف المضارعة الأربعة (أنيت)",
    "letters": {
      "أ": "للمتكلّم المفرد",
      "ن": "للمتكلّمين (نحن)",
      "ي": "للغائب",
      "ت": "للمخاطب أو للغائبة"
