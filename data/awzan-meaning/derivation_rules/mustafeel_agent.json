{
  "rule_id": "mustafeel_agent_derivation",
  "rule_name_ar": "قاعدة اشتقاق اسم الفاعل من باب اِسْتَفْعَل على وزن مُسْتَفْعِل",
  "target_pattern": "مُسْتَفْعِل",
  "target_pattern_id": "mustafeel_agent",
  "summary_ar": "ميم مضمومة + سين ساكنة + تاء مفتوحة + فاء ساكنة + عين مكسورة + لام، يدلّ على من يطلب وقوع الفعل أو يحاول إيقاعه، اسم الفاعل من باب اِسْتَفْعَل.",

  "base_rule": {
    "description_ar": "اسم الفاعل من الفعل المزيد بالسين والتاء والهمزة (باب اِسْتَفْعَل) يُصاغ على وزن مُسْتَفْعِل بأخذ المضارع وقلب حرف المضارعة ميماً مضمومة مع كسر ما قبل الآخر.",
    "operations": [
      {
        "step": 1,
        "operation_id": "take_mudari",
        "description_ar": "خذ مضارع الفعل (يَسْتَفْعِل)",
        "input_type": "mudari",
        "expected_pattern": "يَسْتَفْعِل"
      },
      {
        "step": 2,
        "operation_id": "replace_yaa_with_mim_damma",
        "description_ar": "اقلب ياء المضارعة المفتوحة ميماً مضمومة",
        "transformation": "يَ → مُ"
      },
      {
        "step": 3,
        "operation_id": "verify_kasra",
        "description_ar": "تأكّد من كسر ما قبل الآخر (وهو محقّق في يَسْتَفْعِل)",
        "verify": "second_to_last is kasrah"
      }
    ],
    "example_walkthrough": {
      "root": ["خ", "ر", "ج"],
      "verb_past": "اِسْتَخْرَجَ",
      "verb_present": "يَسْتَخْرِج",
      "transformation": "يَسْتَخْرِج → مُسْتَخْرِج",
      "result": "مُسْتَخْرِج"
    }
  },

  "application_conditions": {
    "description_ar": "تنطبق صيغة 'مُسْتَفْعِل' بالشروط التالية",
    "conditions": [
      {
        "condition_id": "from_form10_verb",
        "description_ar": "من فعل على باب اِسْتَفْعَل (الثلاثي المزيد بالسين والتاء والهمزة)",
        "check": "verb_form == 'اِسْتَفْعَل'",
        "form_number": 10
      },
      {
        "condition_id": "active_voice",
        "description_ar": "اسم فاعل لا مفعول (المعلوم لا المجهول)",
        "check": "voice == 'active'"
      }
    ]
  },

