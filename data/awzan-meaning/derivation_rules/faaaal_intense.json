{
  "rule_id": "faaaal_intensified_derivation",
  "rule_name_ar": "قاعدة اشتقاق صيغة المبالغة على وزن فَعَّال",
  "target_pattern": "فَعَّال",
  "target_pattern_id": "faaaal_intense",
  "summary_ar": "فاء مفتوحة + عين مضعّفة مفتوحة + ألف زائدة + لام، تدلّ على من اتصف بالفعل اتصافاً شديداً أو كثيراً، وتدلّ كثيراً على الحرفة والصناعة.",

  "base_rule": {
    "description_ar": "صيغة المبالغة على وزن فَعَّال تُصاغ من الفعل الثلاثي المتعدّي بفتح فائه، وتضعيف عينه مع فتحها، وزيادة ألف بعد العين، وتدلّ على المبالغة في القيام بالفعل والمداومة عليه.",
    "operations": [
      {
        "step": 1,
        "operation_id": "fath_fa",
        "description_ar": "فتح فاء الكلمة",
        "target_position": "root[0]",
        "harakah": "fatha",
        "harakah_code": "\u064E"
      },
      {
        "step": 2,
        "operation_id": "double_ain",
        "description_ar": "تضعيف عين الكلمة (شدّة) مع فتحها",
        "target_position": "root[1]",
        "double_letter": true,
        "harakah": "fatha",
        "shadda_code": "\u0651"
      },
      {
        "step": 3,
        "operation_id": "insert_alif",
        "description_ar": "زيادة ألف بعد العين المضعّفة",
        "insert_after": "root[1]",
        "insert_letter": "ا"
      }
    ],
    "example_walkthrough": {
      "root": ["ك", "ت", "ب"],
      "verb": "كَتَبَ",
      "wazn_template": "فَ + عّـ + ا + ل",
      "derivation": "كَ + تّـ + ا + ب",
      "result": "كَتَّاب",
      "meaning_ar": "كثير الكتابة، الذي يحترف الكتابة"
    }
  },

  "application_conditions": {
    "description_ar": "تنطبق صيغة 'فَعَّال' بالشروط التالية",
    "conditions": [
      {
        "condition_id": "is_trilateral",
        "description_ar": "ثلاثي مجرد",
        "check": "len(root) == 3 and no_augmentations(verb)"
      },
      {
        "condition_id": "is_transitive_or_intensive",
        "description_ar": "يصحّ في المتعدّي واللازم، بشرط أن يقبل المبالغة",
