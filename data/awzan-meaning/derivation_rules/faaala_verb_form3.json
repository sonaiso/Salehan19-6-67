            "result": "كَاتَبَ",
            "meaning_ar": "تبادل الكتابة معه"
          },
          {
            "original": "قَتَلَ",
            "result": "قَاتَلَ"
          }
        ]
      },
      {
        "label_ar": "التكثير",
        "examples": [
