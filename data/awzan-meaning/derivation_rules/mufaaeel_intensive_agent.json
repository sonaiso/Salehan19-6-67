    {"verb": "عَدَّلَ", "result": "مُعَدِّل"}
  ],

  "related_patterns": {
    "description_ar": "أوزان اسم الفاعل من الأفعال المزيدة",
    "patterns": [
      {"form": 2, "verb_pattern": "فَعَّل", "agent_pattern": "مُفَعِّل", "example": "عَلَّمَ → مُعَلِّم"},
      {"form": 3, "verb_pattern": "فَاعَل", "agent_pattern": "مُفَاعِل", "example": "كَاتَبَ → مُكَاتِب"},
      {"form": 4, "verb_pattern": "أَفْعَل", "agent_pattern": "مُفْعِل", "example": "أَكْرَمَ → مُكْرِم"},
      {"form": 5, "verb_pattern": "تَفَعَّل", "agent_pattern": "مُتَفَعِّل", "example": "تَعَلَّمَ → مُتَعَلِّم"},
      {"form": 6, "verb_pattern": "تَفَاعَل", "agent_pattern": "مُتَفَاعِل", "example": "تَكَاتَبَ → مُتَكَاتِب"},
      {"form": 7, "verb_pattern": "اِنْفَعَل", "agent_pattern": "مُنْفَعِل", "example": "اِنْكَسَرَ → مُنْكَسِر"},
      {"form": 8, "verb_pattern": "اِفْتَعَل", "agent_pattern": "مُفْتَعِل", "example": "اِجْتَمَعَ → مُجْتَمِع"},
      {"form": 10, "verb_pattern": "اِسْتَفْعَل", "agent_pattern": "مُسْتَفْعِل", "example": "اِسْتَخْرَجَ → مُسْتَخْرِج"}
    ]
  },

  "general_rule_for_non_trilateral_agent": {
    "label_ar": "القاعدة العامة لاسم الفاعل من غير الثلاثي",
    "rule_ar": "يُؤتى بمضارعه + يُقلب حرف المضارعة ميماً مضمومة + يُكسر ما قبل الآخر",
    "exception_ar": "إن كان مضارعه مفتوح ما قبل الآخر يبقى مفتوحاً (اِحْمَرَّ → يَحْمَرّ → مُحْمَرّ)"
  }
}
